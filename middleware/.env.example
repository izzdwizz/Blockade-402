ARC_RPC_URL=https://rpc.mainnet.arc.io
CONTRACT_ADDRESS=
OPENAI_API_KEY=
# Leave LLM_BASE_URL empty to use OpenAI directly. To use Groq's OpenAI-compatible
# endpoint instead, set LLM_BASE_URL=https://api.groq.com/openai/v1, put your Groq
# key in OPENAI_API_KEY above, and set LLM_MODEL to a Groq-hosted model id
# (e.g. openai/gpt-oss-20b) — see https://console.groq.com/docs/models.
LLM_BASE_URL=
LLM_MODEL=gpt-4o-mini
RESOURCE_ADDRESS=
PRICE_USDC=5000
ARC_CHAIN_ID=5042
FREE_INPUT_CHAR_CAP=200
FREE_MAX_TOKENS=150
PAID_SESSION_TTL_SECONDS=3600
# Comma-separated list of origins allowed to call this API from a browser.
CORS_ORIGINS=http://localhost:5173
