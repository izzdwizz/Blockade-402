ARC_RPC_URL=https://rpc.mainnet.arc.io
CONTRACT_ADDRESS=
OPENAI_API_KEY=
# Leave LLM_BASE_URL empty to use OpenAI directly. To use Groq's OpenAI-compatible
# endpoint instead, set LLM_BASE_URL=https://api.groq.com/openai/v1, put your Groq
# key in OPENAI_API_KEY above, and set LLM_MODEL to a Groq-hosted model id
# (e.g. openai/gpt-oss-20b) — see https://console.groq.com/docs/models.
LLM_BASE_URL=
LLM_MODEL=gpt-4o-mini
RESOURCE_ADDRESS=
ARC_CHAIN_ID=5042
FREE_MAX_TOKENS=150
# How long one payment unlocks a tile for a wallet, in seconds.
PAID_SESSION_TTL_SECONDS=3600
# Comma-separated list of origins allowed to call this API from a browser.
CORS_ORIGINS=http://localhost:5173
# Redis-compatible connection string backing tile-unlock state. Render injects
# this automatically when a Key Value service is linked to this web service.
REDIS_URL=redis://localhost:6379/0
# Privy — used to verify access tokens locally (no external call at request
# time) so paid chat requests can be scoped to a stable per-user identity
# (the `sub`/DID claim) for persistent memory, rather than a self-reported
# wallet address. PRIVY_APP_ID must match the frontend's VITE_PRIVY_APP_ID.
# PRIVY_VERIFICATION_KEY comes from Privy Dashboard > Configuration > App
# settings > "Verification key" — NOT the App Secret (that's a different
# credential, used for other server-SDK operations this app doesn't make).
# It's a PEM EC public key; store it as ONE line with literal \n sequences
# (not real newlines — those get mangled by some dashboard env-var UIs), e.g.:
#   PRIVY_VERIFICATION_KEY="-----BEGIN PUBLIC KEY-----\nMFkw...\n-----END PUBLIC KEY-----"
# If left blank, memory silently stays off — the rest of the app is unaffected.
PRIVY_APP_ID=
PRIVY_VERIFICATION_KEY=
